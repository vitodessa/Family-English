# Скопируй в .env и заполни. Файл .env в git НЕ попадает (см. .gitignore).

# Секрет для подписи cookie-сессий. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please

# База данных. По умолчанию — SQLite в папке data/ (постоянный диск).
# Чтобы переехать на PostgreSQL, заменить на:
#   postgresql+psycopg://user:pass@host:5432/family
# DATABASE_URL=sqlite:///./data/family.db

# Первый администратор создаётся при старте, если задан пароль.
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Сколько карточек выдавать новому ученику на старте
INITIAL_CARDS=20

# --- AI-модули (Speaking, Reading). Без ключей модули отдают заглушку. ---
# Мозг — Claude (нужен для Speaking и Reading), голос — ElevenLabs (нужен для Speaking).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Основная модель (педагогика/диалог) и дешёвая быстрая модель для простых задач
# (перевод слова при чтении). Haiku заметно быстрее и дешевле Sonnet.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# --- Отчёт родителю через Telegram-бота (по завершении урока дня) ---
# 1) Создать бота у @BotFather → получить токен. 2) Узнать chat_id чата
#    (например, написать боту и открыть https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
